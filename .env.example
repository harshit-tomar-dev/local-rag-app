# =====================================================================
# Local RAG & Study AI Configuration
# =====================================================================
PROJECT_NAME="Local RAG & Study AI Assistant"
DATABASE_PATH="data/rag.db"
UPLOADS_DIR="data/uploads"
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS="*"

# ---------------------------------------------------------------------
# Active LLM Provider Selection
# Options: openai | claude | gemini | groq | ollama | openrouter | extractive
# ---------------------------------------------------------------------
LLM_PROVIDER=extractive
LLM_MODEL=extractive

# ---------------------------------------------------------------------
# AI Provider API Keys
# (You can also enter your keys directly in the Web UI Settings modal!)
# ---------------------------------------------------------------------

# 1. OpenAI (ChatGPT - gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=

# 2. Anthropic (Claude - claude-3-5-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=

# 3. Google Gemini (gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_API_KEY=

# 4. Groq (Ultra-fast - llama-3.3-70b-versatile, mixtral-8x7b)
GROQ_API_KEY=

# 5. OpenRouter (Multi-model access)
OPENROUTER_API_KEY=

# 6. Local Ollama (Offline - llama3.2, mistral, deepseek-r1)
LLM_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------
# Dense Embedding Provider (Optional for Hybrid Vector Retrieval)
# Options: none | ollama
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
